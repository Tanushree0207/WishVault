# WishVault Environment Configuration
# Copy this file to .env and customize for your environment.

# Flask Application Settings
FLASK_APP=run.py
FLASK_ENV=development
DEBUG=True

# Security Configuration
# IMPORTANT: Generate a strong secret key in production (e.g. using `python -c "import secrets; print(secrets.token_hex(32))"`)
SECRET_KEY=wishvault-insecure-dev-secret-key-change-in-production-1234567890

# Database Configuration (SQLite default)
DATABASE_URL=sqlite:///wishvault.db

# Cookie & Session Security Settings
# In production with HTTPS, set SESSION_COOKIE_SECURE to True
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME_HOURS=2

# Rate Limiting Storage (memory:// or redis://)
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_DEFAULT=200 per day, 50 per hour
RATELIMIT_AUTH=5 per minute

# Content Security Policy (enforce or report-only)
CSP_REPORT_ONLY=False

# Demo Account Credentials (Used for automatic seeding in dev mode)
DEMO_EMAIL=demo@wishvault.local
DEMO_PASSWORD=replace-with-your-own-local-demo-password
DEMO_NAME=Demo User
SEED_DEMO_DATA=True
